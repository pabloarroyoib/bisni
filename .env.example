# ---------------------------------------------------------------------------
# Sanity (obligatorias)
# ---------------------------------------------------------------------------
# Las encuentras en https://www.sanity.io/manage -> tu proyecto
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# Versión de la API de Sanity (opcional, por defecto la definida en sanity/env.ts)
NEXT_PUBLIC_SANITY_API_VERSION="2026-10-20"

# Token de lectura. Solo se usa en el servidor; no lo expongas con NEXT_PUBLIC_.
# Necesario para previsualizar borradores y para Sanity Live.
SANITY_API_READ_TOKEN=""

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# URL pública canónica, usada en sitemap.xml, robots.txt y metadatos Open Graph.
NEXT_PUBLIC_SITE_URL="https://bisni.es"

# ---------------------------------------------------------------------------
# Formulario de contacto
# ---------------------------------------------------------------------------
# Vía principal: email por SMTP con Zoho Mail. Si SMTP_USER, SMTP_PASS y
# CONTACT_TO están definidos, el formulario envía un email a ese buzón y no usa
# el webhook. Si faltan, se usa CONTACT_WEBHOOK_URL.

# Cuenta completa de Zoho Mail (por ejemplo hola@bisni.es). No es el email del
# visitante que rellena el formulario.
SMTP_USER=""

# Contraseña de aplicación de Zoho Mail, NO la contraseña de la cuenta.
# Se genera en Zoho Mail: Configuración -> Seguridad -> Contraseñas de aplicación.
SMTP_PASS=""

# Servidor SMTP de Zoho. 465 usa SSL directo; 587 usa STARTTLS.
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"

# Remitente visible. Si se deja vacío se usa SMTP_USER. Debe ser del mismo
# dominio que SMTP_USER para no caer en la carpeta de spam.
CONTACT_FROM=""

# Buzón que recibe las consultas del formulario.
CONTACT_TO=""

# Alternativa: webhook (Slack/Make/Zapier/Formspree/hook propio) en lugar de
# SMTP. Solo se usa cuando falta la configuración SMTP de arriba.
# Si no hay ni SMTP ni webhook, en desarrollo el envío se imprime en consola y
# en producción el formulario muestra un fallback a email.
CONTACT_WEBHOOK_URL=""

# Secreto opcional que se envía en la cabecera Authorization del webhook.
CONTACT_WEBHOOK_SECRET=""
