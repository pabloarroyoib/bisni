# ---------------------------------------------------------------------------
# Sanity (obligatorias)
# ---------------------------------------------------------------------------
# Las encuentras en https://www.sanity.io/manage -> tu proyecto
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# Versión de la API de Sanity (opcional, por defecto la definida en sanity/env.ts)
NEXT_PUBLIC_SANITY_API_VERSION="2026-10-20"

# Token de lectura. Solo se usa en el servidor; no lo expongas con NEXT_PUBLIC_.
# Necesario para previsualizar borradores y para Sanity Live.
SANITY_API_READ_TOKEN=""

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# URL pública canónica, usada en sitemap.xml, robots.txt y metadatos Open Graph.
NEXT_PUBLIC_SITE_URL="https://bisni.es"

# ---------------------------------------------------------------------------
# Formulario de contacto (opcional)
# ---------------------------------------------------------------------------
# Endpoint que recibe los envíos (Slack/Make/Zapier/Formspree/webhook propio).
# Si no se define, en desarrollo se imprime en consola y en producción el
# formulario muestra un fallback a email.
CONTACT_WEBHOOK_URL=""

# Secreto opcional que se envía en la cabecera Authorization del webhook.
CONTACT_WEBHOOK_SECRET=""
